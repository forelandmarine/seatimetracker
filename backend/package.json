{
  "name": "sandbox-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --outdir=dist --platform=node --target=node20 --format=esm --packages=external --sourcemap && cp -r src/assets dist/assets",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "db:generate": "tsx node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:push": "npm run db:generate && npm run db:migrate"
  },
  "dependencies": {
    "@fastify/aws-lambda": "6.1.1",
    "@fastify/multipart": "9.3.0",
    "@fastify/websocket": "11.2.0",
    "@sentry/node": "^9.0.0",
    "better-auth": "1.4.5",
    "drizzle-orm": "0.44.7",
    "exceljs": "^4.4.0",
    "fastify": "5.7.1",
    "jose": "6.2.2",
    "pdfkit": "0.17.2",
    "pino": "9.5.0",
    "pino-pretty": "13.1.3",
    "postgres": "3.4.7",
    "resend": "4.0.0"
  },
  "devDependencies": {
    "@types/node": "22.19.3",
    "drizzle-kit": "0.31.5",
    "esbuild": "0.27.3",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  }
}
