{
  "cli": {
    "version": ">= 5.0.0",
    "appVersionSource": "local",
    "requireCommit": false
  },
  "build": {
    "development": {
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "ios": {},
      "android": {},
      "channel": "preview",
      "env": {
        "APP_VARIANT": "preview"
      }
    },
    "production": {
      "ios": {},
      "android": {},
      "channel": "production",
      "env": {
        "APP_VARIANT": "production"
      }
    },
    "ios-simulator": {
      "extends": "preview",
      "ios": {
        "simulator": true
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleTeamId": "43GZCFFPR9"
      },
      "android": {
        "serviceAccountKeyPath": "./pc-service-account.json",
        "track": "beta",
        "releaseStatus": "completed"
      }
    }
  }
}